{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "edge-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"APP_NAME": "edge-api",
		"COURSE_NAME": "devops-core"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "fcf0153be41240dd97981a42674e717f"
		}
	],
	"observability": {
		"enabled": true
	}
}